<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.educms.controller.MainLayoutController" styleClass="app-root">

    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="4">
            <VBox styleClass="sidebar-header" spacing="2">
                <padding><Insets top="24" right="16" bottom="24" left="16"/></padding>
                <Label text="Educational CMS" styleClass="sidebar-title"/>
                <Label fx:id="userLabel" styleClass="sidebar-user"/>
                <Label fx:id="roleLabel" styleClass="sidebar-role"/>
            </VBox>

            <Button fx:id="navDashboard" text="📊  Dashboard" onAction="#showDashboard" styleClass="nav-button"/>
            <Button fx:id="navArticles" text="📰  Articles" onAction="#showArticles" styleClass="nav-button"/>
            <Button fx:id="navBlogs" text="✍  Blog Posts" onAction="#showBlogs" styleClass="nav-button"/>
            <Button fx:id="navMedia" text="🖼  Media Library" onAction="#showMedia" styleClass="nav-button"/>
            <Button fx:id="navUsers" text="👤  User Management" onAction="#showUsers" styleClass="nav-button"/>
            <Button fx:id="navReports" text="🧾  Reports" onAction="#showReports" styleClass="nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⎋  Sign Out" onAction="#handleLogout" styleClass="nav-button,logout-button"/>
            <Region prefHeight="16"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>
</BorderPane>
