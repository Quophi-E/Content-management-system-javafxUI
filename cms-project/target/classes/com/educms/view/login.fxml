<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.educms.controller.LoginController" styleClass="auth-root">
    <VBox alignment="CENTER" maxWidth="380" spacing="18" styleClass="auth-card">
        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

        <VBox alignment="CENTER" spacing="4">
            <Label text="Educational CMS" styleClass="auth-title"/>
            <Label text="Sign in to manage content" styleClass="auth-subtitle"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Username"/>
            <TextField fx:id="usernameField" promptText="e.g. admin"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Password"/>
            <PasswordField fx:id="passwordField" promptText="Password" onAction="#handleLogin"/>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

        <Button text="Sign In" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-button"/>

        <HBox alignment="CENTER" spacing="4">
            <Label text="New here?"/>
            <Hyperlink text="Create an account" onAction="#goToRegister"/>
        </HBox>

        <Label text="Default admin: admin / Admin@123" styleClass="hint-label"/>
    </VBox>
</StackPane>
