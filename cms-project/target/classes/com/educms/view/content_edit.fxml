<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.educms.controller.ContentEditController" prefWidth="520" styleClass="dialog-root">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label fx:id="dialogTitleLabel" styleClass="page-title"/>

    <VBox spacing="6">
        <Label text="Title"/>
        <TextField fx:id="titleField"/>
    </VBox>

    <HBox spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Category"/>
            <TextField fx:id="categoryField" promptText="e.g. Technology"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Status"/>
            <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <VBox spacing="6">
        <Label text="Tags (comma-separated)"/>
        <TextField fx:id="tagsField" promptText="education, tutorial, java"/>
    </VBox>

    <VBox spacing="6" VBox.vgrow="ALWAYS">
        <Label text="Body"/>
        <TextArea fx:id="bodyArea" wrapText="true" prefHeight="220"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel"/>
        <Button text="Save" onAction="#handleSave" styleClass="primary-button"/>
    </HBox>
</VBox>
