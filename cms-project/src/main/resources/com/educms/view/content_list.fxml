<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.educms.controller.ContentListController" styleClass="page">
    <padding><Insets top="28" right="32" bottom="28" left="32"/></padding>

    <VBox spacing="2">
        <Label fx:id="pageTitleLabel" styleClass="page-title"/>
        <Label fx:id="pageSubtitleLabel" styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search by title, category, or tag..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="statusFilterCombo" promptText="All statuses"/>
        <Button text="＋ New" onAction="#handleNew" styleClass="primary-button"/>
    </HBox>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="260"/>
            <TableColumn fx:id="authorColumn" text="Author" prefWidth="140"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="130"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
            <TableColumn fx:id="updatedColumn" text="Last Updated" prefWidth="150"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="160"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</VBox>
